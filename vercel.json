{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": ".",
      "framework": "django",
      "entrypoint": "app:application",
      "buildCommand": "python scripts/build_vercel.py",
      "functions": {
        "app.py": {
          "regions": ["fra1"],
          "maxDuration": 60,
          "includeFiles": "{frontend/dist/**,backend/templates/**}",
          "excludeFiles": "{.local/**,documents/**,deploy-data/**,frontend/node_modules/**,backend/media/**,backend/private_uploads/**,backend/db.sqlite3}"
        }
      }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
